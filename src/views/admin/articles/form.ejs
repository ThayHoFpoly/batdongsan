<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Quản trị</title>
  <meta name="robots" content="noindex, nofollow">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    /* Rich Text Editor Styling */
    .editor-toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      padding: 8px 10px;
      background: #F1F5F9;
      border: 1px solid var(--admin-border-dark);
      border-bottom: none;
      border-radius: 6px 6px 0 0;
    }
    .editor-btn {
      padding: 6px 10px;
      background: #FFFFFF;
      border: 1px solid var(--admin-border);
      border-radius: 4px;
      font-size: 13px;
      font-weight: 600;
      color: var(--admin-text);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 32px;
      height: 32px;
      transition: background 0.15s;
    }
    .editor-btn:hover {
      background: #E2E8F0;
    }
    .editor-content {
      min-height: 380px;
      padding: 16px;
      background: #FFFFFF;
      border: 1px solid var(--admin-border-dark);
      border-radius: 0 0 6px 6px;
      outline: none;
      font-size: 15px;
      line-height: 1.8;
      overflow-y: auto;
    }
    .editor-content:focus {
      border-color: var(--admin-primary);
      box-shadow: 0 0 0 3px rgba(24, 61, 53, 0.1);
    }
    .editor-content img {
      max-width: 100%;
      height: auto;
      border-radius: 4px;
      margin: 12px 0;
    }
    .editor-content blockquote {
      border-left: 4px solid var(--admin-accent);
      padding-left: 14px;
      color: #64748B;
      font-style: italic;
      margin: 14px 0;
    }
  </style>
</head>
<body>
  <div class="admin-layout">
    <%- include('../../partials/admin-sidebar') %>

    <div class="admin-main">
      <%- include('../../partials/admin-header') %>

      <main class="admin-body">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
          <a href="/admin/articles" class="btn btn-sm btn-outline">&larr; Quay lại danh sách bài viết</a>
          <% if (isEdit && article._id) { %>
            <a href="/admin/articles/<%= article._id %>/preview" target="_blank" class="btn btn-sm btn-outline">
              Xem trước bài viết &nearr;
            </a>
          <% } %>
        </div>

        <% if (successMsg) { %>
          <div class="alert alert-success"><%= successMsg %></div>
        <% } %>
        <% if (errorMsg) { %>
          <div class="alert alert-danger"><%= errorMsg %></div>
        <% } %>

        <form action="<%= isEdit ? '/admin/articles/' + article._id : '/admin/articles' %>" method="POST" data-track-changes="true" id="articleForm" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; align-items: start;">
            <!-- Cột Trái: Nội dung chính -->
            <div>
              <div class="card">
                <div class="card-header">
                  <h2 class="card-title"><%= isEdit ? 'Chỉnh sửa nội dung bài viết' : 'Soạn thảo bài viết mới' %></h2>
                </div>
                <div class="card-body">
                  <div class="form-group">
                    <label for="title">Tiêu đề bài viết <span class="required">*</span></label>
                    <input type="text" id="title" name="title" class="form-control" value="<%= article.title %>" placeholder="Nhập tiêu đề bài viết" required style="font-size: 1.1rem; font-weight: 600;">
                  </div>

                  <div class="form-group">
                    <label for="slug">Đường dẫn tĩnh (Slug URL) <span class="required">*</span></label>
                    <input type="text" id="slug" name="slug" class="form-control" value="<%= article.slug %>" placeholder="slug-bai-viet-tu-dong" required>
                    <div class="form-hint">
                      <% if (isEdit) { %>
                        Quy định: Slug được giữ nguyên khi sửa tiêu đề để tránh gãy liên kết SEO trừ khi bạn chủ động thay đổi tại ô này.
                      <% } else { %>
                        Tự động sinh từ tiêu đề tiếng Việt chuẩn SEO.
                      <% } %>
                    </div>
                  </div>

                  <div class="form-group">
                    <label for="excerpt">Trích đoạn tóm tắt (Excerpt) <span class="required">*</span></label>
                    <textarea id="excerpt" name="excerpt" class="form-control" style="min-height: 80px;" placeholder="Tóm tắt ngắn 1-3 câu hiển thị trên thẻ bài viết và mạng xã hội" required maxlength="500"><%= article.excerpt %></textarea>
                  </div>

                  <!-- Trình Soạn Thảo Rich Text -->
                  <div class="form-group">
                    <label>Nội dung chi tiết bài viết <span class="required">*</span></label>

                    <div class="editor-toolbar" role="toolbar" aria-label="Định dạng bài viết">
                      <button type="button" class="editor-btn" data-command="formatBlock" data-value="p" title="Đoạn văn">P</button>
                      <button type="button" class="editor-btn" data-command="formatBlock" data-value="h2" title="Tiêu đề H2">H2</button>
                      <button type="button" class="editor-btn" data-command="formatBlock" data-value="h3" title="Tiêu đề H3">H3</button>
                      <span style="border-right: 1px solid var(--admin-border-dark); margin: 0 4px;"></span>
                      <button type="button" class="editor-btn" data-command="bold" title="In đậm (Ctrl+B)"><b>B</b></button>
                      <button type="button" class="editor-btn" data-command="italic" title="In nghiêng (Ctrl+I)"><i>I</i></button>
                      <span style="border-right: 1px solid var(--admin-border-dark); margin: 0 4px;"></span>
                      <button type="button" class="editor-btn" data-command="insertUnorderedList" title="Danh sách chấm tròn">&bull; Danh sách</button>
                      <button type="button" class="editor-btn" data-command="insertOrderedList" title="Danh sách số">1. Số</button>
                      <button type="button" class="editor-btn" data-command="formatBlock" data-value="blockquote" title="Trích dẫn">&ldquo; Trích dẫn</button>
                      <span style="border-right: 1px solid var(--admin-border-dark); margin: 0 4px;"></span>
                      <button type="button" class="editor-btn" id="btnEditorInsertLink" title="Chèn liên kết">🔗 Link</button>
                      <button type="button" class="editor-btn btn-open-media-picker" data-target-input="#editorImageHelper" data-target-preview="#editorImagePreview" title="Chèn ảnh">🖼️ Chèn ảnh</button>
                      <button type="button" class="editor-btn" data-command="removeFormat" title="Xóa định dạng">Clear</button>
                    </div>

                    <!-- Contenteditable Visual Editor -->
                    <div class="editor-content" id="visualEditor" contenteditable="true">
                      <%- article.contentHtml || '<p>Nhập nội dung bài viết tại đây...</p>' %>
                    </div>

                    <!-- Hidden textarea to store sanitized HTML and submit to server -->
                    <textarea name="contentHtml" id="contentHtml" style="display: none;"><%= article.contentHtml %></textarea>
                    <!-- Helper input for media modal insertion -->
                    <input type="hidden" id="editorImageHelper">
                    <img id="editorImagePreview" style="display: none;">
                  </div>
                </div>
              </div>

              <!-- Cấu hình SEO Tùy Chỉnh -->
              <div class="card">
                <div class="card-header">
                  <h2 class="card-title">Cấu hình SEO & Chia sẻ Mạng Xã Hội</h2>
                </div>
                <div class="card-body">
                  <div class="form-group">
                    <label for="seoTitle">Tiêu đề SEO bài viết</label>
                    <input type="text" id="seoTitle" name="seoTitle" class="form-control" value="<%= article.seoTitle || '' %>" placeholder="Để trống nếu muốn sử dụng tiêu đề bài viết">
                  </div>

                  <div class="form-group">
                    <label for="seoDescription">Thẻ mô tả SEO</label>
                    <textarea id="seoDescription" name="seoDescription" class="form-control" style="min-height: 80px;" placeholder="Để trống nếu muốn sử dụng trích đoạn bài viết"><%= article.seoDescription || '' %></textarea>
                  </div>

                  <div class="form-group">
                    <label for="ogImage">Ảnh chia sẻ Facebook / Zalo tùy chỉnh</label>
                    <div class="image-picker-group">
                      <input type="text" id="ogImage" name="ogImage" class="form-control" value="<%= article.ogImage || '' %>" placeholder="Để trống nếu muốn sử dụng ảnh đại diện bài viết">
                      <button type="button" class="btn btn-outline btn-open-media-picker" data-target-input="#ogImage" data-target-preview="#ogPreview">Chọn ảnh</button>
                    </div>
                    <% if (article.ogImage) { %>
                      <img id="ogPreview" src="<%= article.ogImage %>" class="image-preview-thumb" alt="OG Image preview">
                    <% } else { %>
                      <img id="ogPreview" class="image-preview-thumb" style="display: none;" alt="OG Image preview">
                    <% } %>
                  </div>
                </div>
              </div>
            </div>

            <!-- Cột Phải: Xuất bản & Thuộc tính -->
            <div>
              <!-- Khối Xuất Bản -->
              <div class="card">
                <div class="card-header">
                  <h2 class="card-title">Trạng thái xuất bản</h2>
                </div>
                <div class="card-body">
                  <div class="form-group">
                    <label for="status">Trạng thái bài viết</label>
                    <select id="status" name="status" class="form-control" style="font-weight: 600;">
                      <option value="draft" <%= article.status === 'draft' ? 'selected' : '' %>>Bản nháp (Draft)</option>
                      <option value="published" <%= article.status === 'published' ? 'selected' : '' %>>Đã xuất bản (Published)</option>
                    </select>
                    <div class="form-hint">
                      Bài viết xuất bản sẽ xuất hiện công khai trên trang chủ và trang đọc bài.
                    </div>
                  </div>

                  <% if (article.publishedAt) { %>
                    <div style="font-size: 12.5px; color: var(--admin-text-muted); margin-bottom: 16px;">
                      Thời điểm công bố: <strong><%= new Date(article.publishedAt).toLocaleString('vi-VN') %></strong>
                    </div>
                  <% } %>

                  <div style="display: flex; flex-direction: column; gap: 8px;">
                    <button type="submit" class="btn btn-primary" style="width: 100%;">
                      <%= isEdit ? 'Lưu thay đổi bài viết' : 'Lưu và tạo bài viết' %>
                    </button>
                    <a href="/admin/articles" class="btn btn-outline" style="width: 100%;">Hủy bỏ</a>
                  </div>
                </div>
              </div>

              <!-- Khối Ảnh Đại Diện & Phân Loại -->
              <div class="card">
                <div class="card-header">
                  <h2 class="card-title">Ảnh đại diện & Phân loại</h2>
                </div>
                <div class="card-body">
                  <div class="form-group">
                    <label for="coverImage">Ảnh đại diện bài viết</label>
                    <div class="image-picker-group">
                      <input type="text" id="coverImage" name="coverImage" class="form-control" value="<%= article.coverImage || '' %>" placeholder="URL ảnh đại diện">
                      <button type="button" class="btn btn-outline btn-open-media-picker" data-target-input="#coverImage" data-target-preview="#coverPreview">Chọn</button>
                    </div>
                    <% if (article.coverImage) { %>
                      <img id="coverPreview" src="<%= article.coverImage %>" class="image-preview-thumb" style="width: 100%; height: 140px; margin-top: 8px;" alt="Cover preview">
                    <% } else { %>
                      <img id="coverPreview" class="image-preview-thumb" style="width: 100%; height: 140px; display: none; margin-top: 8px;" alt="Cover preview">
                    <% } %>
                  </div>

                  <div class="form-group">
                    <label for="category">Chuyên mục bài viết</label>
                    <input type="text" id="category" name="category" class="form-control" value="<%= article.category || 'Tin tức dự án' %>" placeholder="VD: Tiến độ, Thiết kế, Thị trường">
                  </div>

                  <div class="form-group">
                    <label for="author">Tác giả bài viết</label>
                    <input type="text" id="author" name="author" class="form-control" value="<%= article.author || 'Ban biên tập' %>">
                  </div>
                </div>
              </div>
            </div>
          </div>
        </form>
      </main>
    </div>
  </div>

  <%- include('../../partials/admin-modals') %>
  <script src="/js/admin.js"></script>
  <script>
    // Rich Text Editor Command Execution
    const visualEditor = document.getElementById('visualEditor');
    const contentTextarea = document.getElementById('contentHtml');
    const form = document.getElementById('articleForm');

    document.querySelectorAll('.editor-btn[data-command]').forEach(btn => {
      btn.addEventListener('click', () => {
        const command = btn.getAttribute('data-command');
        const value = btn.getAttribute('data-value') || null;
        document.execCommand(command, false, value);
        visualEditor.focus();
      });
    });

    // Link insertion
    const btnLink = document.getElementById('btnEditorInsertLink');
    if (btnLink) {
      btnLink.addEventListener('click', () => {
        const url = prompt('Nhập địa chỉ URL liên kết (https://...):', 'https://');
        if (url && url !== 'https://') {
          document.execCommand('createLink', false, url);
        }
      });
    }

    // Media Modal Image Insertion
    const editorHelper = document.getElementById('editorImageHelper');
    if (editorHelper) {
      editorHelper.addEventListener('change', () => {
        const imgUrl = editorHelper.value;
        if (imgUrl) {
          visualEditor.focus();
          document.execCommand('insertImage', false, imgUrl);
          editorHelper.value = '';
        }
      });
    }

    // Sync content on form submission
    if (form && visualEditor && contentTextarea) {
      form.addEventListener('submit', () => {
        contentTextarea.value = visualEditor.innerHTML;
      });
    }

    // Automatic slug generation for new article as user types title
    <% if (!isEdit) { %>
      const titleInput = document.getElementById('title');
      const slugInput = document.getElementById('slug');
      if (titleInput && slugInput) {
        titleInput.addEventListener('input', () => {
          if (!slugInput.dataset.manual) {
            let str = titleInput.value.toLowerCase()
              .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
              .replace(/[đĐ]/g, 'd')
              .replace(/([^0-9a-z-\s])/g, '')
              .replace(/(\s+)/g, '-')
              .replace(/-+/g, '-')
              .replace(/^-+|-+$/g, '');
            slugInput.value = str;
          }
        });
        slugInput.addEventListener('input', () => {
          slugInput.dataset.manual = 'true';
        });
      }
    <% } %>
  </script>
</body>
</html>

