<!-- 1. Modal Xác Nhận Xóa Dữ Liệu -->
<div class="modal-backdrop" id="deleteConfirmModal" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle">
  <div class="modal-box">
    <div class="modal-header">
      <h3 class="modal-title" id="deleteModalTitle" style="color: var(--admin-danger);">Xác nhận xóa dữ liệu</h3>
      <button type="button" class="btn btn-sm btn-outline" data-close-modal style="border: none; font-size: 18px;">&times;</button>
    </div>
    <div class="modal-body">
      <p style="margin-bottom: 10px;">
        Bạn có chắc chắn muốn xóa <span id="deleteItemType" style="font-weight: 700;">dữ liệu</span> <span id="deleteItemName" style="font-weight: 700; color: var(--admin-primary);"></span> không?
      </p>
      <p style="color: var(--admin-danger); font-size: 13px; margin-bottom: 0;">
        ⚠️ Lưu ý: Thao tác này sẽ xóa vĩnh viễn khỏi cơ sở dữ liệu và không thể hoàn tác.
      </p>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-outline" data-close-modal>Hủy bỏ</button>
      <form id="deleteConfirmForm" method="POST" style="margin: 0;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-danger">Đồng ý xóa vĩnh viễn</button>
      </form>
    </div>
  </div>
</div>

<!-- 2. Modal Chọn Hình Ảnh Từ Thư Viện Media -->
<div class="modal-backdrop" id="mediaPickerModal" role="dialog" aria-modal="true" aria-labelledby="mediaPickerModalTitle">
  <div class="modal-box" style="max-width: 840px;">
    <div class="modal-header">
      <h3 class="modal-title" id="mediaPickerModalTitle">Chọn hình ảnh từ Thư viện</h3>
      <button type="button" class="btn btn-sm btn-outline" data-close-modal style="border: none; font-size: 18px;">&times;</button>
    </div>
    <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
      <!-- Quick upload form -->
      <form id="mediaPickerUploadForm" style="margin-bottom: 16px; padding: 12px; background: #F1F5F9; border-radius: 6px; display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label style="font-size: 13px; font-weight: 700;">Tải ảnh mới:</label>
        <input type="file" name="file" accept="image/*" required style="font-size: 13px; flex: 1;">
        <button type="submit" class="btn btn-sm btn-primary">Tải lên ngay</button>
      </form>

      <!-- Grid -->
      <div class="media-grid" id="mediaPickerGrid">
        <!-- Loaded via AJAX -->
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-outline" data-close-modal>Đóng</button>
    </div>
  </div>
</div>

