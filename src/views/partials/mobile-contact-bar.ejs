<%
  const hasPhone = Boolean(salesContact && salesContact.phone);
  const hasMessenger = Boolean(salesContact && salesContact.messengerUrl && salesContact.messengerUrl.trim().length > 0);
  const hasZalo = Boolean(salesContact && salesContact.zaloUrl && salesContact.zaloUrl.trim().length > 0);
%>

<% if (hasPhone || hasMessenger || hasZalo) { %>
  <nav class="mobile-sticky-bar" aria-label="Thanh liên hệ nhanh trên thiết bị di động">
    <% if (hasPhone) { %>
      <a href="tel:<%= salesContact.phone.replace(/\s+/g, '') %>" class="mobile-sticky-item item-call" aria-label="Gọi điện thoại hotline <%= salesContact.phone %>">
        <span class="mobile-sticky-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </span>
        <span>Gọi điện</span>
      </a>
    <% } %>

    <% if (hasMessenger) { %>
      <a href="<%= salesContact.messengerUrl %>" target="_blank" rel="noopener noreferrer" class="mobile-sticky-item" aria-label="Chat Messenger với tư vấn viên">
        <span class="mobile-sticky-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
        </span>
        <span>Messenger</span>
      </a>
    <% } %>

    <% if (hasZalo) { %>
      <a href="<%= salesContact.zaloUrl %>" target="_blank" rel="noopener noreferrer" class="mobile-sticky-item" aria-label="Nhắn tin Zalo với tư vấn viên">
        <span class="mobile-sticky-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
        </span>
        <span>Zalo</span>
      </a>
    <% } %>
  </nav>
<% } %>
